+/// [ieum 0035] HWPML `LINE` → 선 개체.
+fn into_line(source: HmlRectangle) -> Control {
+    use crate::model::shape::LineShape;
+    let line = source.line.unwrap_or_default();
+    let common = CommonObjAttr {
+        ctrl_id: crate::parser::tags::CTRL_GEN_SHAPE,
+        width: source.width,
+        height: source.height,
+        horizontal_offset: source.horizontal_offset as u32,
+        vertical_offset: source.vertical_offset as u32,
+        treat_as_char: source.treat_as_char,
+        flow_with_text: source.flow_with_text,
+        allow_overlap: source.allow_overlap,
+        vert_rel_to: source.vert_rel_to,
+        vert_align: source.vert_align,
+        horz_rel_to: source.horz_rel_to,
+        horz_align: source.horz_align,
+        text_wrap: source.text_wrap,
+        ..Default::default()
+    };
+    let drawing = DrawingObjAttr {
+        shape_attr: source.shape_attr,
+        border_line: source.border_line,
+        fill: source.fill,
+        ..Default::default()
+    };
+    Control::Shape(Box::new(ShapeObject::Line(LineShape {
+        common,
+        drawing,
+        start: crate::model::Point {
+            x: line.start.0,
+            y: line.start.1,
+        },
+        end: crate::model::Point {
+            x: line.end.0,
+            y: line.end.1,
+        },
+        started_right_or_bottom: line.reversed,
+        ..Default::default()
+    })))
+}
+
+/// [ieum 0035] HWPML `HEADER`/`FOOTER` → 머리말·꼬리말.
+fn into_header_footer(
+    source: super::reader::HmlHeaderFooter,
+) -> Result<Control, HmlError> {
+    use crate::model::header_footer::{Footer, Header};
+    let paragraphs = source
+        .paragraphs
+        .into_iter()
+        .map(into_paragraph)
+        .collect::<Result<Vec<_>, _>>()?;
+    Ok(if source.is_header {
+        Control::Header(Box::new(Header {
+            apply_to: source.apply_to,
+            paragraphs,
+            ..Default::default()
+        }))
+    } else {
+        Control::Footer(Box::new(Footer {
+            apply_to: source.apply_to,
+            paragraphs,
+            ..Default::default()
+        }))
+    })
+}
