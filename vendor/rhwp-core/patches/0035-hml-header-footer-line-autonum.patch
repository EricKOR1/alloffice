+    /// [ieum 0035] `LINE`: 사각형과 같은 칸에 크기·배치를 담고, 두 끝점을 더한다.
+    fn start_line(&mut self, element: &BytesStart<'_>) -> Result<(), HmlError> {
+        self.reserve_control_slot()?;
+        let point = |x: &[u8], y: &[u8]| -> Result<(i32, i32), HmlError> {
+            Ok((
+                parse_attribute(element, x)?.unwrap_or(0),
+                parse_attribute(element, y)?.unwrap_or(0),
+            ))
+        };
+        self.rectangles.push(HmlRectangle {
+            line: Some(HmlLine {
+                start: point(b"StartX", b"StartY")?,
+                end: point(b"EndX", b"EndY")?,
+                reversed: parse_bool_attribute(element, b"IsReverseHV")?,
+            }),
+            ..Default::default()
+        });
+        Ok(())
+    }
+
+    fn finish_line(&mut self) -> Result<(), HmlError> {
+        let line = self
+            .rectangles
+            .pop()
+            .ok_or_else(|| HmlError::InvalidXml("unexpected LINE end".to_string()))?;
+        self.current_paragraph()?
+            .controls
+            .push(HmlControl::Line(line));
+        Ok(())
+    }
+
+    fn start_header_footer(
+        &mut self,
+        is_header: bool,
+        element: &BytesStart<'_>,
+    ) -> Result<(), HmlError> {
+        use crate::model::header_footer::HeaderFooterApply;
+        self.reserve_control_slot()?;
+        let apply_to = match attribute(element, b"ApplyPageType")?.as_deref() {
+            Some("Even") => HeaderFooterApply::Even,
+            Some("Odd") => HeaderFooterApply::Odd,
+            _ => HeaderFooterApply::Both,
+        };
+        self.header_footers.push(HmlHeaderFooter {
+            is_header,
+            apply_to,
+            paragraphs: Vec::new(),
+        });
+        Ok(())
+    }
+
+    fn finish_header_footer(&mut self) -> Result<(), HmlError> {
+        let header_footer = self
+            .header_footers
+            .pop()
+            .ok_or_else(|| HmlError::InvalidXml("unexpected HEADER/FOOTER end".to_string()))?;
+        self.current_paragraph()?
+            .controls
+            .push(HmlControl::HeaderFooter(header_footer));
+        Ok(())
+    }
+
+    /// [ieum 0035] `AUTONUM Number NumberType` → 자동 번호. 형식은 자식 `AUTONUMFORMAT`.
+    fn start_auto_number(&mut self, element: &BytesStart<'_>) -> Result<(), HmlError> {
+        use crate::model::control::{AutoNumber, AutoNumberType};
+        self.reserve_control_slot()?;
+        let number: u16 = parse_attribute(element, b"Number")?.unwrap_or(1);
+        let number_type = match attribute(element, b"NumberType")?.as_deref() {
+            Some("Footnote") => AutoNumberType::Footnote,
+            Some("Endnote") => AutoNumberType::Endnote,
+            Some("Figure") => AutoNumberType::Picture,
+            Some("Table") => AutoNumberType::Table,
+            Some("Equation") => AutoNumberType::Equation,
+            Some("TotalPage") => AutoNumberType::TotalPage,
+            _ => AutoNumberType::Page,
+        };
+        self.current_paragraph()?
+            .controls
+            .push(HmlControl::AutoNumber(AutoNumber {
+                number_type,
+                number,
+                assigned_number: number,
+                ..Default::default()
+            }));
+        Ok(())
+    }
+
+    fn capture_auto_number_format(&mut self, element: &BytesStart<'_>) -> Result<(), HmlError> {
+        if self.stack.iter().rev().nth(1).map(String::as_str) != Some("AUTONUM") {
+            return Ok(());
+        }
+        let superscript = parse_bool_attribute(element, b"Superscript")?;
+        // HWP 번호 모양: 0 아라비아 숫자, 1 동그라미 숫자, 2 로마 대문자, 3 로마 소문자,
+        // 4 영문 대문자, 5 영문 소문자
+        let format = match attribute(element, b"Type")?.as_deref() {
+            Some("CircledDigit") => 1,
+            Some("RomanCapital") => 2,
+            Some("RomanSmall") => 3,
+            Some("LatinCapital") => 4,
+            Some("LatinSmall") => 5,
+            _ => 0,
+        };
+        if let Ok(paragraph) = self.current_paragraph() {
+            if let Some(HmlControl::AutoNumber(number)) = paragraph.controls.last_mut() {
+                number.superscript = superscript;
+                number.format = format;
+            }
+        }
+        Ok(())
+    }
