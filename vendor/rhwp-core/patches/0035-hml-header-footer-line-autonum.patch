+    #[test]
+    fn test_hml_footer_with_line_and_page_number_is_read() {
+        // [ieum 0035] the footer of an HWPML 2.7 test paper: a rule and the page number
+        let sample = include_str!("../../samples/hml/formatting_table.hml");
+        let footer = concat!(
+            "<FOOTER ApplyPageType=\"Both\" SeriesNum=\"3\"><PARALIST LineWrap=\"Break\" ",
+            "LinkListID=\"0\" LinkListIDNext=\"0\" TextDirection=\"0\" VertAlign=\"Bottom\">",
+            "<P ParaShape=\"0\" Style=\"0\"><TEXT CharShape=\"0\">",
+            "<LINE EndX=\"100\" EndY=\"100\" IsReverseHV=\"false\" StartX=\"0\" StartY=\"0\">",
+            "<SHAPEOBJECT InstId=\"1\" Lock=\"false\" NumberingType=\"Figure\" ZOrder=\"0\">",
+            "<SIZE Height=\"1\" HeightRelTo=\"Absolute\" Protect=\"false\" Width=\"51592\" ",
+            "WidthRelTo=\"Absolute\"/><POSITION AffectLSpacing=\"false\" AllowOverlap=\"true\" ",
+            "FlowWithText=\"false\" HoldAnchorAndSO=\"false\" HorzAlign=\"Left\" HorzOffset=\"0\" ",
+            "HorzRelTo=\"Para\" TreatAsChar=\"true\" VertAlign=\"Top\" VertOffset=\"0\" ",
+            "VertRelTo=\"Para\"/></SHAPEOBJECT><DRAWINGOBJECT><SHAPECOMPONENT CurHeight=\"1\" ",
+            "CurWidth=\"51592\" GroupLevel=\"0\" OriHeight=\"100\" OriWidth=\"100\" XPos=\"0\" ",
+            "YPos=\"0\"/><LINESHAPE Alpha=\"0\" Color=\"7895160\" EndCap=\"Flat\" Style=\"Solid\" ",
+            "Width=\"227\"/></DRAWINGOBJECT></LINE>",
+            "<AUTONUM Number=\"1\" NumberType=\"Page\"><AUTONUMFORMAT Superscript=\"false\" ",
+            "Type=\"Digit\"/></AUTONUM><CHAR/></TEXT></P></PARALIST></FOOTER>"
+        );
+        let xml = sample.replacen("<CHAR>abc</CHAR>", &format!("<CHAR>abc</CHAR>{footer}"), 1);
+        assert_ne!(xml, sample);
+        let parsed = parse_document_with_metadata(xml.as_bytes()).expect("opens");
+        let footer = parsed.document.sections[0]
+            .paragraphs
+            .iter()
+            .flat_map(|p| p.controls.iter())
+            .find_map(|c| match c {
+                crate::model::control::Control::Footer(f) => Some(f),
+                _ => None,
+            })
+            .expect("the footer is a control");
+        let controls: Vec<_> = footer.paragraphs.iter().flat_map(|p| p.controls.iter()).collect();
+        assert!(controls.iter().any(|c| matches!(
+            c,
+            crate::model::control::Control::Shape(shape)
+                if matches!(**shape, crate::model::shape::ShapeObject::Line(_))
+        )));
+        assert!(controls.iter().any(|c| matches!(
+            c,
+            crate::model::control::Control::AutoNumber(n)
+                if n.number_type == crate::model::control::AutoNumberType::Page
+        )));
+        let skipped = parsed
+            .hml_metadata
+            .expect("metadata")
+            .warnings
+            .iter()
+            .filter(|w| w.code == hml::HmlWarningCode::UnsupportedElement)
+            .filter(|w| w.xml_path.starts_with("/HWPML/BODY/"))
+            .count();
+        assert_eq!(skipped, 0);
+    }
