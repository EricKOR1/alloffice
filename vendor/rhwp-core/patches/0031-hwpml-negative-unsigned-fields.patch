 src/parser/hml/reader.rs | 24 ++++++++++++++++++++++++
 src/parser/mod.rs        | 10 ++++++++++
 2 files changed, 34 insertions(+)

diff --git a/src/parser/hml/reader.rs b/src/parser/hml/reader.rs
index 071d0e51..ff60f15a 100755
--- a/src/parser/hml/reader.rs
+++ b/src/parser/hml/reader.rs
@@ -1703,11 +1703,35 @@ where
         .map(|value| {
             value
                 .parse()
+                .or_else(|_| parse_wrapped_negative(&value))
                 .map_err(|_| HmlError::InvalidXml(format!("invalid numeric attribute {value}")))
         })
         .transpose()
 }
 
+/// [ieum 0031] A negative number in a field the model keeps unsigned (an offset or size that
+/// HWP stores as the two's complement of a signed value): read it as those same bits, as the
+/// binary HWP reader does. Older Hancom HWPML writes such fields signed (`-1566`). A value no
+/// unsigned width can hold this way stays an error.
+fn parse_wrapped_negative<T>(value: &str) -> Result<T, ()>
+where
+    T: std::str::FromStr,
+{
+    let negative: i64 = value.trim().parse().map_err(|_| ())?;
+    if negative >= 0 {
+        return Err(());
+    }
+    for bits in [32u32, 16, 8] {
+        let span = 1i64 << bits;
+        if negative >= -(span / 2) {
+            if let Ok(parsed) = (negative + span).to_string().parse() {
+                return Ok(parsed);
+            }
+        }
+    }
+    Err(())
+}
