+    /// `INSIDEMARGIN` 은 표의 안쪽 여백이거나 그림의 안쪽 여백이다. 칸 안 그림의 여백이
+    /// 바깥 표의 여백을 덮지 않도록 바로 위 요소로 가른다.
+    fn capture_inside_margin(&mut self, element: &BytesStart<'_>) -> Result<(), HmlError> {
+        match self.stack.iter().rev().nth(1).map(String::as_str) {
+            Some("TABLE") => self.capture_table_padding(element),
