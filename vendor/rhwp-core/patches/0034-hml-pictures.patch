+        if let Some(picture) = self.current_picture() {
+            picture.bin_item = bin_item;
+            picture.brightness = brightness;
+            picture.contrast = contrast;
+            picture.alpha = alpha;
+            picture.effect = effect;
+        }
+        Ok(())
+    }
