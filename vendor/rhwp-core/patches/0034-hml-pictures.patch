+/// [ieum 0034] 그림 자료: `BINITEM` 순서가 그림이 가리키는 번호(1부터)이고, 바이트는
+/// `TAIL/BINDATASTORAGE` 의 `BINDATA`(Base64, `Compress="true"` 면 deflate)에서 온다.
+/// 이 저장소는 HML 다시 쓰기를 위해 원문 그대로 보존되므로 그 원문에서 읽는다.
+fn move_bin_data(source: &HmlSource, document: &mut Document) {
+    use crate::model::bin_data::{BinData, BinDataContent, BinDataType};
+    if source.bin_items.is_empty() {
+        return;
+    }
+    let mut stored = std::collections::HashMap::new();
+    for fragment in &source.preserved_fragments {
+        if fragment.xml_path.ends_with("/BINDATASTORAGE") {
+            for (id, bytes) in bin_data_in_storage(&fragment.raw_xml) {
+                stored.insert(id, bytes);
+            }
+        }
+    }
+    for (index, item) in source.bin_items.iter().enumerate() {
+        let storage_id = (index + 1) as u16;
+        let extension = if item.format.is_empty() {
+            "bmp".to_string()
+        } else {
+            item.format.clone()
+        };
+        document.doc_info.bin_data_list.push(BinData {
+            data_type: if item.embedded {
+                BinDataType::Embedding
+            } else {
+                BinDataType::Link
+            },
+            storage_id,
+            extension: Some(extension.clone()),
+            ..Default::default()
+        });
+        let bytes = stored.remove(&item.bin_data).unwrap_or_default();
+        document.bin_data_content.push(BinDataContent {
+            id: storage_id,
+            data: bytes.into(),
+            extension,
+        });
+    }
+}
+
+/// `<BINDATA Id=".." Encoding="Base64" [Compress="true"]>…</BINDATA>` 들의 (Id, 바이트).
+fn bin_data_in_storage(xml: &str) -> Vec<(u16, Vec<u8>)> {
+    use base64::Engine as _;
+    let mut found = Vec::new();
+    let mut rest = xml;
+    while let Some(open) = rest.find("<BINDATA ") {
+        let after = &rest[open..];
+        let Some(tag_end) = after.find('>') else { break };
+        let tag = &after[..tag_end];
+        let body_start = open + tag_end + 1;
+        if tag.ends_with('/') {
+            rest = &rest[body_start..];
+            continue;
+        }
+        let Some(close) = rest[body_start..].find("</BINDATA>") else { break };
+        let body = &rest[body_start..body_start + close];
+        rest = &rest[body_start + close + "</BINDATA>".len()..];
+        let attr = |name: &str| -> Option<&str> {
+            let key = format!(" {name}=\"");
+            let at = tag.find(&key)? + key.len();
+            let end = tag[at..].find('"')?;
+            Some(&tag[at..at + end])
+        };
+        let Some(id) = attr("Id").and_then(|v| v.trim().parse::<u16>().ok()) else {
+            continue;
+        };
+        if attr("Encoding").is_some_and(|e| !e.eq_ignore_ascii_case("Base64")) {
+            continue;
+        }
+        let clean: String = body.chars().filter(|c| !c.is_whitespace()).collect();
+        let Ok(mut bytes) = base64::engine::general_purpose::STANDARD.decode(clean.as_bytes())
+        else {
+            continue;
+        };
+        if attr("Compress").is_some_and(|v| v.eq_ignore_ascii_case("true")) {
+            if let Some(inflated) = inflate(&bytes) {
+                bytes = inflated;
+            }
+        }
+        found.push((id, bytes));
+    }
+    found
+}
+
+fn inflate(bytes: &[u8]) -> Option<Vec<u8>> {
+    use std::io::Read as _;
+    let limit = crate::model::bin_data::MAX_BIN_DATA_BYTES as u64;
+    let mut out = Vec::new();
+    if flate2::read::DeflateDecoder::new(bytes)
+        .take(limit)
+        .read_to_end(&mut out)
+        .is_ok()
+    {
+        return Some(out);
+    }
+    out.clear();
+    flate2::read::ZlibDecoder::new(bytes)
+        .take(limit)
+        .read_to_end(&mut out)
+        .ok()
+        .map(|_| out)
+}
