+    }
+
+    fn capture_image(&mut self, element: &BytesStart<'_>) -> Result<(), HmlError> {
+        use crate::model::image::ImageEffect;
+        let bin_item = parse_attribute(element, b"BinItem")?.unwrap_or(0);
+        let brightness = parse_attribute(element, b"Bright")?.unwrap_or(0);
+        let contrast = parse_attribute(element, b"Contrast")?.unwrap_or(0);
+        let alpha = parse_attribute(element, b"Alpha")?.unwrap_or(0);
+        let effect = match attribute(element, b"Effect")?.as_deref() {
+            Some("GrayScale") => ImageEffect::GrayScale,
+            Some("BlackWhite") => ImageEffect::BlackWhite,
+            Some("Pattern8x8") => ImageEffect::Pattern8x8,
+            _ => ImageEffect::RealPic,
