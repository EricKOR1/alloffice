+/// [ieum 0034] HWPML `PICTURE` → 그림 컨트롤. 크기·배치는 사각형과 같이 읽은 값이다.
+fn into_picture(source: HmlRectangle) -> Control {
+    use crate::model::image::{CropInfo, ImageAttr, Picture};
+    let data = source.picture.unwrap_or_default();
+    let mut shape_attr = source.shape_attr;
+    if shape_attr.current_width == 0 {
+        shape_attr.current_width = source.width;
+    }
+    if shape_attr.current_height == 0 {
+        shape_attr.current_height = source.height;
+    }
+    let common = CommonObjAttr {
+        ctrl_id: crate::parser::tags::CTRL_GEN_SHAPE,
+        width: source.width,
+        height: source.height,
+        horizontal_offset: source.horizontal_offset as u32,
+        vertical_offset: source.vertical_offset as u32,
+        treat_as_char: source.treat_as_char,
+        flow_with_text: source.flow_with_text,
+        allow_overlap: source.allow_overlap,
+        vert_rel_to: source.vert_rel_to,
+        vert_align: source.vert_align,
+        horz_rel_to: source.horz_rel_to,
+        horz_align: source.horz_align,
+        text_wrap: source.text_wrap,
+        hwp5_gen_shape_attr_bit26: true,
+        ..Default::default()
+    };
+    let [left, top, right, bottom] = data.crop;
+    Control::Picture(Box::new(Picture {
+        common,
+        shape_attr,
+        border_x: data.border_x,
+        border_y: data.border_y,
+        crop: CropInfo {
+            left,
+            top,
+            right,
+            bottom,
+        },
+        padding: data.padding,
+        image_attr: ImageAttr {
+            brightness: data.brightness,
+            contrast: data.contrast,
+            effect: data.effect,
+            bin_data_id: data.bin_item,
+            transparency: data.alpha.min(100),
+            ..Default::default()
+        },
+        reverse: data.reverse,
+        ..Default::default()
+    }))
+}
