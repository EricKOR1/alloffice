+    /// [ieum 0034] `PICTURE`: 본문(TEXT) 직계면 컨트롤 자리를 잡는다. 묶음 안의 그림은
+    /// 묶음이 자리를 잡는다.
+    fn start_picture(&mut self, element: &BytesStart<'_>) -> Result<(), HmlError> {
+        let in_text = self.stack.iter().rev().nth(1).map(String::as_str) == Some("TEXT");
+        if in_text {
+            self.reserve_control_slot()?;
+        }
+        self.rectangles.push(HmlRectangle {
+            picture: Some(HmlPicture {
+                reverse: parse_bool_attribute(element, b"Reverse")?,
+                ..Default::default()
+            }),
+            ..Default::default()
+        });
+        Ok(())
+    }
+
+    fn start_container(&mut self) -> Result<(), HmlError> {
+        let parent = self.stack.iter().rev().nth(1).map(String::as_str);
+        if parent == Some("TEXT") {
+            self.reserve_control_slot()?;
+        }
+        self.rectangles.push(HmlRectangle {
+            container: Some(HmlContainer {
+                xml_path: format!("/{}", self.stack.join("/")),
+                ..Default::default()
+            }),
+            ..Default::default()
+        });
+        Ok(())
+    }
+
+    fn current_picture(&mut self) -> Option<&mut HmlPicture> {
+        if self.stack.iter().rev().nth(1).map(String::as_str) != Some("PICTURE") {
+            return None;
+        }
+        self.rectangles
+            .last_mut()
+            .and_then(|rectangle| rectangle.picture.as_mut())
+    }
+
+    fn capture_image_rect(&mut self, element: &BytesStart<'_>) -> Result<(), HmlError> {
+        let mut x = [0i32; 4];
+        let mut y = [0i32; 4];
+        for (index, key) in [b"X0", b"X1", b"X2", b"X3"].iter().enumerate() {
+            x[index] = parse_attribute(element, *key)?.unwrap_or(0);
+        }
+        for (index, key) in [b"Y0", b"Y1", b"Y2", b"Y3"].iter().enumerate() {
+            y[index] = parse_attribute(element, *key)?.unwrap_or(0);
+        }
+        if let Some(picture) = self.current_picture() {
+            picture.border_x = x;
+            picture.border_y = y;
+        }
+        Ok(())
+    }
+
+    fn capture_image_clip(&mut self, element: &BytesStart<'_>) -> Result<(), HmlError> {
+        let crop = [
+            parse_attribute(element, b"Left")?.unwrap_or(0),
+            parse_attribute(element, b"Top")?.unwrap_or(0),
+            parse_attribute(element, b"Right")?.unwrap_or(0),
+            parse_attribute(element, b"Bottom")?.unwrap_or(0),
+        ];
+        if let Some(picture) = self.current_picture() {
+            picture.crop = crop;
+        }
