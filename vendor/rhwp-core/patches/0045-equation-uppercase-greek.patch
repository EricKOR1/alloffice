 .../fixtures/m09_expand/over_greek.golden     | 20 +++++++++----------
 src/renderer/equation/symbols.rs              | 14 +++++++++++++
 2 files changed, 24 insertions(+), 10 deletions(-)

diff --git a/src/renderer/equation/fixtures/m09_expand/over_greek.golden b/src/renderer/equation/fixtures/m09_expand/over_greek.golden
index 10b7776cd..292e5fab7 100644
