diff --git a/src/serializer/hml/preflight.rs b/src/serializer/hml/preflight.rs
index 17a7c85d..0db273c0 100644
--- a/src/serializer/hml/preflight.rs
+++ b/src/serializer/hml/preflight.rs
@@ -289,8 +289,24 @@ fn validate_paragraph(paragraph: &Paragraph, path: &str, blockers: &mut Vec<HmlS
         "paragraph character-shape runs cannot be reconstructed by the HML reader",
         blockers,
     );
+    // [ieum 0037] the HML reader marks a paragraph that holds a COLDEF as a multi-column
+    // break (bit 0x02), so that bit comes back whenever the column definition is written
+    let holds_column_def = paragraph
+        .controls
+        .iter()
+        .any(|control| matches!(control, crate::model::control::Control::ColumnDef(_)));
+    let (column_type, raw_break_type) = if holds_column_def {
+        let without = paragraph.raw_break_type & !0x02;
+        let kind = match paragraph.column_type {
+            ColumnBreakType::MultiColumn => ColumnBreakType::None,
+            other => other,
+        };
+        (kind, without)
+    } else {
+        (paragraph.column_type, paragraph.raw_break_type)
+    };
     let supported_break = matches!(
-        (paragraph.column_type, paragraph.raw_break_type),
+        (column_type, raw_break_type),
         (ColumnBreakType::None, 0)
             | (ColumnBreakType::Page, 0x04)
             | (ColumnBreakType::Column, 0x08)
