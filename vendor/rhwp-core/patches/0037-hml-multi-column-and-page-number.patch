 4 files changed, 62 insertions(+), 4 deletions(-)

diff --git a/src/parser/hml/adapter.rs b/src/parser/hml/adapter.rs
index 0b1a17d9..be787853 100644
--- a/src/parser/hml/adapter.rs
+++ b/src/parser/hml/adapter.rs
@@ -112,11 +112,22 @@ fn into_paragraph(source: HmlParagraph) -> Result<Paragraph, HmlError> {
     if char_shapes.is_empty() {
         char_shapes.push(CharShapeRef::default());
     }
+    // [ieum 0037] 단 정의를 담은 문단은 HWP 의 "다단 나누기"(PARA_HEADER bit 1)다. HWPX
+    // 해석기와 같이 쪽·단 나누기와 비트로 합친다. 고치기 전에는 본문 중간의 2단 정의가
+    // 무시되어 2단 시험지가 1단으로 그려졌다.
+    let mut raw_break_type = source.raw_break_type;
+    let mut column_type = source.column_type;
+    if controls.iter().any(|c| matches!(c, Control::ColumnDef(_))) {
+        raw_break_type |= 0x02;
+        if column_type == crate::model::paragraph::ColumnBreakType::None {
+            column_type = crate::model::paragraph::ColumnBreakType::MultiColumn;
+        }
+    }
     Ok(Paragraph {
         para_shape_id: source.para_shape_id,
         style_id: source.style_id,
-        column_type: source.column_type,
-        raw_break_type: source.raw_break_type,
+        column_type,
+        raw_break_type,
         char_count: source.raw_pos + 1,
         has_para_text: !source.text.is_empty() || !controls.is_empty(),
         text: source.text,
