상위 ef7fcf6a4(#7865)를 0.8.7 토크나이저에 옮겼다. 상위는 그 사이 바뀐
화살표 축약 코드 위에 있어 그대로 붙지 않는다.
---
 src/renderer/equation/tokenizer.rs | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/src/renderer/equation/tokenizer.rs b/src/renderer/equation/tokenizer.rs
index 93c7487f9..e143ffecb 100644
--- a/src/renderer/equation/tokenizer.rs
+++ b/src/renderer/equation/tokenizer.rs
@@ -306,6 +306,20 @@ impl Tokenizer {
             return Some(Token::new(TokenType::Symbol, s, start));
         }
 
+        // 한컴 수식 편집기의 `+-`·`-+` 축약은 ±·∓ 다(상위 #7865). `+->` 는 `+` 뒤 화살표,
+        // `<-+` 의 `-+` 는 `<` 뒤 부호 둘이라 종전대로 나눈다.
+        if ch == '+' && next == '-' && third != '>' {
+            self.pos += 2;
+            return Some(Token::new(TokenType::Command, "PLUSMINUS", start));
+        }
+        if ch == '-' && next == '+' {
+            let prev = if self.pos > 0 { self.chars[self.pos - 1] } else { '\0' };
+            if prev != '<' {
+                self.pos += 2;
+                return Some(Token::new(TokenType::Command, "MINUSPLUS", start));
+            }
+        }
+
         // -> (화살표 축약)
         if ch == '-' && next == '>' {
             self.pos += 2;
@@ -612,6 +626,20 @@ mod tests {
             .collect()
     }
 
+    #[test]
+    fn plus_minus_shorthands_read_as_commands() {
+        let mut tz = Tokenizer::new("a +- b -+ c +-> d");
+        let toks: Vec<(TokenType, String)> = std::iter::from_fn(|| {
+            let t = tz.next_token();
+            (t.ty != TokenType::Eof).then(|| (t.ty, t.value))
+        })
+        .collect();
+        let values: Vec<&str> = toks.iter().map(|(_, v)| v.as_str()).collect();
+        assert!(values.contains(&"PLUSMINUS"), "{values:?}");
+        assert!(values.contains(&"MINUSPLUS"), "{values:?}");
+        assert!(values.contains(&"->"), "+-> keeps its arrow: {values:?}");
+    }
+
     #[test]
     fn test_simple_fraction() {
         let tokens = tokenize("1 over 2");
