diff --git a/src/document_core/queries/rendering.rs b/src/document_core/queries/rendering.rs
index 3a83fdec..8cf2b917 100644
--- a/src/document_core/queries/rendering.rs
+++ b/src/document_core/queries/rendering.rs
@@ -4911,6 +4911,83 @@ impl DocumentCore {
     /// 측정 통일(B). `paginate_pass` 의 `force_break_before` 훅과 `LayoutOverflow` 의
     /// section_index/is_first_in_column 계측은 측정 통일 작업의 진단·후속용으로 유지한다.
     pub(crate) fn paginate(&mut self) {
+        self.paginate_sections();
+        self.sync_edited_table_heights();
+    }
+
+    /// [ieum 0029] 칸의 글을 고친 최상위 글자처럼 취급 표의 선언 높이를 그린 높이에 맞춘다.
+    /// 한컴 한글처럼 늘어난 높이를 저장해, 다시 열었을 때 옛 선언 높이로 눌려 겹치지
+    /// 않게 한다. 처음 고칠 때의 높이보다 작게는 줄이지 않는다.
+    fn sync_edited_table_heights(&mut self) {
+        use crate::model::shape::common_obj_offsets;
+        let dpi = self.dpi;
+        for (sec_idx, tables) in self.measured_tables.iter().enumerate() {
+            let Some(section) = self.document.sections.get_mut(sec_idx) else {
+                continue;
+            };
+            for mt in tables {
+                let Some(Control::Table(table)) = section
+                    .paragraphs
+                    .get_mut(mt.para_index)
+                    .and_then(|p| p.controls.get_mut(mt.control_index))
+                else {
+                    continue;
+                };
+                let Some(base) = table.edited_base_height else {
+                    continue;
+                };
+                if !table.common.treat_as_char {
+                    continue;
+                }
+                let drawn_px = mt.cumulative_heights.last().copied().unwrap_or(0.0);
+                if drawn_px <= 0.0 {
+                    continue;
+                }
+                let drawn = crate::renderer::px_to_hwpunit(drawn_px, dpi).max(0) as u32;
+                let height = base.max(drawn);
+                let previous = table.common.height;
+                if height == previous {
+                    continue;
+                }
+                table.common.height = height;
+                if table.raw_ctrl_data.len() >= common_obj_offsets::HEIGHT.end {
+                    table.raw_ctrl_data[common_obj_offsets::HEIGHT]
+                        .copy_from_slice(&height.to_le_bytes());
+                }
+                // 한글은 글자처럼 취급한 표가 든 줄의 높이에 표 높이를 적는다. 그 줄의
+                // 저장 높이도 함께 바꿔야 쪽 나누기가 옛 높이로 다음 글을 앞당기지 않는다.
+                if let Some(host) = section.paragraphs.get_mut(mt.para_index) {
+                    Self::resize_stored_tac_line(host, previous, height);
+                }
+            }
+        }
+    }
+
+    /// [ieum 0029] 높이가 `previous`인 표를 담은 저장 줄(한글이 표 높이를 그대로 적은 줄)의
+    /// 높이를 `height`로 바꾼다. 기준선은 같은 비율로 옮긴다.
+    fn resize_stored_tac_line(
+        host: &mut crate::model::paragraph::Paragraph,
+        previous: u32,
+        height: u32,
+    ) {
+        let (Ok(previous), Ok(height)) = (i32::try_from(previous), i32::try_from(height)) else {
+            return;
+        };
+        if previous <= 0 {
+            return;
+        }
+        for seg in host.line_segs.iter_mut() {
+            if seg.line_height != previous || seg.text_height != previous {
+                continue;
+            }
+            seg.line_height = height;
+            seg.text_height = height;
+            seg.baseline_distance = ((i64::from(seg.baseline_distance) * i64::from(height))
+                / i64::from(previous)) as i32;
+        }
+    }
+
