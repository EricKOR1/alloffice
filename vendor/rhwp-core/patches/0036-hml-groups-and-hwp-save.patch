+    fn rendering_owner_is_drawing(&self) -> bool {
+        let Some(info) = self.stack.iter().rposition(|name| name == "RENDERINGINFO") else {
+            return false;
+        };
+        let mut at = info;
+        if at == 0 || self.stack[at - 1] != "SHAPECOMPONENT" {
+            return false;
+        }
+        at -= 1;
+        if at > 0 && self.stack[at - 1] == "DRAWINGOBJECT" {
