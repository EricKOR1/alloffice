+/// [ieum 0036] HWPML 묶음 개체 → 묶음 도형. 바깥 개체가 크기·배치를, 자식이 묶음 안
+/// 좌표(SHAPECOMPONENT 의 위치와 행렬)를 갖는다.
+fn into_group(outer: HmlRectangle, children: Vec<HmlRectangle>) -> Result<Control, HmlError> {
+    use crate::model::shape::GroupShape;
+    let mut shapes = Vec::with_capacity(children.len());
+    for child in children {
+        if child.picture.is_some() {
+            if let Control::Picture(mut picture) = into_picture(child) {
+                picture.shape_attr.flip |= 0x0003_0000;
+                shapes.push(ShapeObject::Picture(picture));
+            }
+        } else if let Control::Shape(shape) = into_rectangle(child)? {
+            shapes.push(*shape);
+        }
+    }
+    let mut shape_attr = outer.shape_attr.clone();
+    shape_attr.local_file_version = 1;
+    if shape_attr.flip == 0 {
+        shape_attr.flip = 0x0009_0000;
+    }
+    let common = CommonObjAttr {
+        ctrl_id: crate::parser::tags::CTRL_GEN_SHAPE,
+        width: outer.width,
+        height: outer.height,
+        horizontal_offset: outer.horizontal_offset as u32,
+        vertical_offset: outer.vertical_offset as u32,
+        treat_as_char: outer.treat_as_char,
+        flow_with_text: outer.flow_with_text,
+        allow_overlap: outer.allow_overlap,
+        vert_rel_to: outer.vert_rel_to,
+        vert_align: outer.vert_align,
+        horz_rel_to: outer.horz_rel_to,
+        horz_align: outer.horz_align,
+        text_wrap: outer.text_wrap,
+        hwp5_gen_shape_attr_bit26: true,
+        ..Default::default()
+    };
+    Ok(Control::Shape(Box::new(ShapeObject::Group(GroupShape {
+        common,
+        shape_attr,
+        children: shapes,
+        caption: None,
+    }))))
+}
