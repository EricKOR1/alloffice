+    /// 행렬을 HWP 와 같이 합성한다: 이동 × (회전 × 크기)…, 그리고 HWP5 저장용 원본 행렬.
+    fn finish_rendering_info(&mut self) {
+        let Some(object) = self.rectangles.last_mut() else {
+            return;
+        };
+        let Some(mut rendering) = object.rendering.take() else {
+            return;
+        };
+        if let Some(scale) = rendering.pending_scale.take() {
+            rendering.pairs.push((scale, IDENTITY_MATRIX));
+        }
+        let mut result = rendering.trans;
+        for (scale, rotation) in &rendering.pairs {
+            result = compose_matrix(&result, rotation);
+            result = compose_matrix(&result, scale);
+        }
+        let attr = &mut object.shape_attr;
+        attr.render_sx = result[0];
+        attr.render_b = result[1];
+        attr.render_tx = result[2];
+        attr.render_c = result[3];
+        attr.render_sy = result[4];
+        attr.render_ty = result[5];
+        let mut raw = Vec::with_capacity(2 + 48 + rendering.pairs.len() * 96);
+        raw.extend_from_slice(&(rendering.pairs.len() as u16).to_le_bytes());
+        let mut push = |matrix: &[f64; 6]| {
+            for value in matrix {
+                raw.extend_from_slice(&value.to_le_bytes());
+            }
+        };
+        push(&rendering.trans);
+        for (scale, rotation) in &rendering.pairs {
+            push(scale);
+            push(rotation);
+        }
+        attr.raw_rendering = raw;
+    }
