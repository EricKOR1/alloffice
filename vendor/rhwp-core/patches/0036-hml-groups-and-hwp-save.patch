+        let mut ids = Vec::new();
+        fn walk(paragraphs: &[crate::model::paragraph::Paragraph], out: &mut Vec<u16>) {
+            for p in paragraphs {
+                for c in &p.controls {
+                    match c {
+                        crate::model::control::Control::Picture(pic) => {
+                            out.push(pic.image_attr.bin_data_id)
+                        }
+                        crate::model::control::Control::Table(t) => {
+                            for cell in &t.cells {
+                                walk(&cell.paragraphs, out);
+                            }
+                        }
+                        _ => {}
+                    }
+                }
+            }
+        }
+        walk(&saved.sections[0].paragraphs, &mut ids);
+        ids.sort();
+        assert_eq!(ids, vec![1, 2]);
+        assert_eq!(saved.bin_data_content.len(), 2);
+        for content in &saved.bin_data_content {
+            assert!(content.data.load().starts_with(b"\x89PNG"), "picture {} kept", content.id);
+        }
+    }
