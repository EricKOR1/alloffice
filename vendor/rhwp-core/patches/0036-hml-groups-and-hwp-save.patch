+            .paragraphs
+            .iter()
+            .flat_map(|p| p.controls.iter())
+            .find_map(|c| match c {
+                crate::model::control::Control::Shape(shape) => match &**shape {
+                    crate::model::shape::ShapeObject::Group(g) => Some(g),
