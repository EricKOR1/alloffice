+    fn capture_matrix(&mut self, name: &str, element: &BytesStart<'_>) -> Result<(), HmlError> {
+        if self.stack.iter().rev().nth(1).map(String::as_str) != Some("RENDERINGINFO")
+            || !self.rendering_owner_is_drawing()
+        {
+            return Ok(());
+        }
+        let mut matrix = [0.0f64; 6];
+        for (index, key) in [b"E1", b"E2", b"E3", b"E4", b"E5", b"E6"].iter().enumerate() {
+            let value: f64 = parse_attribute(element, *key)?.unwrap_or(0.0);
+            // HWP5 keeps the matrix in f32 precision unless it is a whole number
+            matrix[index] = if value.fract() == 0.0 {
+                value
+            } else {
+                f64::from(value as f32)
+            };
+        }
+        let Some(rendering) = self
+            .rectangles
+            .last_mut()
+            .and_then(|object| object.rendering.as_mut())
+        else {
+            return Ok(());
+        };
+        match name {
+            "TRANSMATRIX" => rendering.trans = matrix,
+            "SCAMATRIX" => rendering.pending_scale = Some(matrix),
+            _ => {
+                let scale = rendering.pending_scale.take().unwrap_or(IDENTITY_MATRIX);
+                rendering.pairs.push((scale, matrix));
+            }
+        }
+        Ok(())
+    }
