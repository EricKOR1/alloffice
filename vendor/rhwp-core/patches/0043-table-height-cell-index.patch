같은 (행, 열)의 첫 셀을 한 번 색인해 find 와 같은 셀을 돌려준다.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit ef90aed188c899fb5d67d33725523d057d925765)
(cherry picked from commit 8a673b566c8017deaa7d8f160ec27ffb0774ba47)
---
 src/renderer/height_measurer.rs | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/src/renderer/height_measurer.rs b/src/renderer/height_measurer.rs
index 8a7f8a9bc..5e14e7de1 100644
--- a/src/renderer/height_measurer.rs
+++ b/src/renderer/height_measurer.rs
@@ -4839,12 +4839,15 @@ impl HeightMeasurer {
                 };
             }
         }
+        // 측정 셀마다 표 전체를 찾지 않도록 (행, 열)의 첫 셀을 한 번 색인한다.
+        let mut cell_at = std::collections::HashMap::with_capacity(table.cells.len());
+        for cell in &table.cells {
+            cell_at
+                .entry((cell.row as usize, cell.col as usize))
+                .or_insert(cell);
+        }
         for mc in &mut measured_cells {
-            let Some(cell) = table
-                .cells
-                .iter()
-                .find(|c| c.row as usize == mc.row && c.col as usize == mc.col)
-            else {
+            let Some(&cell) = cell_at.get(&(mc.row, mc.col)) else {
                 continue;
             };
             let wrap_bottom = self.cell_wrap_objects_bottom_height(&cell.paragraphs);
