표 전체를 훑는 leading_header_rows 를 셀마다 부르는 any 안에서 한 번만 센다.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit d1b4197b988a4117886aa771d297030752d586c6)
(cherry picked from commit 98ff8eb3c7eaa9bbcba47e4102945e496185daf2)
---
 src/renderer/layout/table_partial.rs | 25 +++++++++++++++----------
 1 file changed, 15 insertions(+), 10 deletions(-)

diff --git a/src/renderer/layout/table_partial.rs b/src/renderer/layout/table_partial.rs
index d7b7c9cba..5965b4cb9 100644
--- a/src/renderer/layout/table_partial.rs
+++ b/src/renderer/layout/table_partial.rs
@@ -4700,19 +4700,24 @@ impl LayoutEngine {
                 )
                 && table.row_count > 1
                 && table.repeat_header
-                && !table.leading_header_rows().is_empty()
                 // 이 보정은 반복 제목행 바로 뒤에서 표 끝까지 걸친 가운데
                 // 정렬 셀의 저장 물리 높이를 두 조각에 나누는 경우에만 필요하다.
                 // 일반 83행 교육 표까지 열면 다른 조각이 본문 아래로 밀린다.
-                && table.cells.iter().any(|cell| {
-                    cell.row as usize == table.leading_header_rows().len()
-                        && cell.row_span > 1
-                        && cell.row as usize + cell.row_span as usize == table.row_count as usize
-                        && matches!(
-                            cell.vertical_align,
-                            crate::model::table::VerticalAlign::Center
-                        )
-                })
+                // 제목행 수는 셀마다 다시 세지 않고 한 번만 센다.
+                && {
+                    let header_rows = table.leading_header_rows().len();
+                    header_rows > 0
+                        && table.cells.iter().any(|cell| {
+                            cell.row as usize == header_rows
+                                && cell.row_span > 1
+                                && cell.row as usize + cell.row_span as usize
+                                    == table.row_count as usize
+                                && matches!(
+                                    cell.vertical_align,
+                                    crate::model::table::VerticalAlign::Center
+                                )
+                        })
+                }
                 && table.outer_margin_top > 0
                 && enclosing_cell_ctx.is_none()
                 && !repeat_fragment_outer_margin
