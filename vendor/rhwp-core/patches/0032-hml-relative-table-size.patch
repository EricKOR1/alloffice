+    #[test]
+    fn test_hml_table_sized_relative_to_the_column_takes_its_cells_width() {
+        // [ieum 0032] 한글 HWPML 2.7 은 단 기준 표를 `Width="100" WidthRelTo="Column"` 으로
+        // 쓴다. 100 HWPUNIT 이 아니라 칸이 적은 폭으로 읽어야 표가 세로 막대가 되지 않는다.
+        let sample = include_str!("../../samples/hml/formatting_table.hml");
+        let absolute = parse_document(sample.as_bytes()).expect("sample opens");
+        let relative_xml = regex_free_relative_table(sample);
+        assert_ne!(relative_xml, sample, "the sample has a table size to make relative");
+        let relative = parse_document(relative_xml.as_bytes()).expect("relative table opens");
+        let width = |doc: &crate::model::document::Document| {
+            doc.sections[0]
+                .paragraphs
+                .iter()
+                .flat_map(|p| p.controls.iter())
+                .find_map(|c| match c {
+                    crate::model::control::Control::Table(t) => Some(t.common.width),
+                    _ => None,
+                })
+                .expect("a table")
+        };
+        assert!(width(&relative) > 1000, "relative width read as cells: {}", width(&relative));
+        assert_eq!(width(&relative), width(&absolute));
+    }
+
+    /// The sample's table SIZE with its width written as 100 % of the column.
+    fn regex_free_relative_table(sample: &str) -> String {
+        let at = sample.find("<TABLE").expect("a table");
+        let size = at + sample[at..].find("<SIZE ").expect("its size");
+        let end = size + sample[size..].find("/>").expect("closed");
+        let tag = &sample[size..end];
+        let width_at = tag.find("Width=\"").expect("a width") + "Width=\"".len();
+        let width_end = width_at + tag[width_at..].find('"').expect("quoted");
+        let rewritten = format!(
+            "{}100{}",
+            &tag[..width_at],
+            tag[width_end..].replacen("WidthRelTo=\"Absolute\"", "WidthRelTo=\"Column\"", 1)
+        );
+        format!("{}{}{}", &sample[..size], rewritten, &sample[end..])
+    }
