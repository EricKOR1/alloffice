+/// [ieum 0032] 한글 HWPML(2.7 등)은 단·쪽 기준 표의 `SIZE Width` 를 퍼센트(`100`)로
+/// 쓴다. 이진 HWP 처럼 표 크기를 HWPUNIT 로 담도록, 칸이 적은 실제 크기로 다시 잰다:
+/// 폭은 한 행에서 시작하는 칸 폭 합의 최댓값, 높이는 행마다 한 행짜리 칸 높이의
+/// 최댓값을 더한 값이다. 칸에서 잴 수 없으면 적힌 값을 그대로 둔다.
+fn resolve_relative_table_size(table: &mut HmlTable) {
+    use std::collections::BTreeMap;
+    if table.relative_width {
+        let mut rows: BTreeMap<u16, u64> = BTreeMap::new();
+        for cell in &table.cells {
+            *rows.entry(cell.row).or_default() += u64::from(cell.width);
+        }
+        if let Some(width) = rows.values().copied().max().filter(|w| *w > 0) {
+            table.common.width = u32::try_from(width).unwrap_or(u32::MAX);
+        }
+    }
+    if table.relative_height {
+        let mut rows: BTreeMap<u16, u32> = BTreeMap::new();
+        for cell in table.cells.iter().filter(|cell| cell.row_span <= 1) {
+            let row = rows.entry(cell.row).or_default();
+            *row = (*row).max(cell.height);
+        }
+        let height: u64 = rows.values().map(|h| u64::from(*h)).sum();
+        if height > 0 {
+            table.common.height = u32::try_from(height).unwrap_or(u32::MAX);
+        }
+    }
+}
